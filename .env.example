# Copy this file to ".env" and fill in the values. Never commit .env.

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Chat model, e.g. gemini-3.8-flash (free tier)
LLM_MODEL=
# Embedding model, e.g. gemini-embedding-2
EMBEDDING_MODEL=
# Must match vector(768) in supabase/migrations/001_init.sql, e.g. 768
EMBEDDING_DIMENSIONS=

# --- Supabase (Project Settings -> API Keys / Data API) ---
SUPABASE_URL=
# The "secret" key (sb_secret_...). Server only, never expose it.
SUPABASE_SECRET_KEY=

# --- App ---
# Password for /admin
ADMIN_PASSWORD=
# Chat messages allowed per visitor IP per day, e.g. 10
RATE_LIMIT_PER_DAY=
# Random string used to sign the admin cookie and the reset endpoint
APP_SECRET=
